# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data & Model Artifacts ────────────────────────────────────────────────────
# Raw source CSVs and full parquet (too large for git — use git-lfs or share separately)
data/*.csv
data/*.parquet
!data/eda_sample.parquet

# Model search log (model .pkl files are tracked so the platform runs out-of-the-box)
models/automl.log

# SQLite database (1.77 GB full database is ignored; lightweight sample DB is tracked)
credit_risk.db
!data/credit_risk_sample.db

# ── Secrets & Config ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS metadata ───────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
